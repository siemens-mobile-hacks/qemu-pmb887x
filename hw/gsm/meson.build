system_ss.add(when: 'CONFIG_GSM_IQ_BUS', if_true: files('iq-bus.c'))
system_ss.add(when: 'CONFIG_GSM_NETWORK', if_true: files('gsm-network.c'))
system_ss.add(when: 'CONFIG_GSM_AIR', if_true: files('gsm-air.c'))
system_ss.add(when: 'CONFIG_GSM_KASUMI', if_true: files('kasumi.c'))
system_ss.add(when: 'CONFIG_GSM_GEA', if_true: files('gea.c'))
system_ss.add(when: 'CONFIG_GSM_CODING', if_true: files('gsm-coding.c'))
system_ss.add(when: 'CONFIG_GSM_BTS', if_true: files('gsm-bts.c', 'gsm-bts-gprs.c'))
system_ss.add(when: 'CONFIG_GSM_OSMOTRX', if_true: files('gsm-osmotrx.c'))
system_ss.add(when: 'CONFIG_HD15515X', if_true: files('hd15515x/hd15515x.c', 'hd15515x/regs.c'))
system_ss.add(when: 'CONFIG_PMB6272', if_true: files('pmb6272/pmb6272.c', 'pmb6272/regs.c'))
