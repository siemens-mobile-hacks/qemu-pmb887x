system_ss.add(when: 'CONFIG_GSM_IQ_BUS', if_true: files('iq-bus.c'))
system_ss.add(when: 'CONFIG_GSM_NETWORK', if_true: files('gsm-network.c'))
system_ss.add(when: 'CONFIG_GSM_AIR', if_true: files('gsm-air.c'))
system_ss.add(when: 'CONFIG_GSM_BTS', if_true: files('gsm-bts.c'))
system_ss.add(when: 'CONFIG_GSM_OSMOTRX', if_true: files('gsm-osmotrx.c'))
system_ss.add(when: 'CONFIG_HD155153NP', if_true: files('hd155153np/hd155153np.c', 'hd155153np/regs.c'))
system_ss.add(when: 'CONFIG_PMB6272', if_true: files('pmb6272/pmb6272.c', 'pmb6272/regs.c'))
